{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ry1",
  "version": "0.1.0",
  "identifier": "com.ry1.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ry1",
        "width": 680,
        "height": 420,
